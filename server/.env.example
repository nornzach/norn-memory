OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
# Host port for the dashboard. docker compose also points the API's CORS origin at it.
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
# Example: DeepSeek LLM + Gemini embeddings
#   MEM0_DEFAULT_LLM_PROVIDER=deepseek / MEM0_DEFAULT_LLM_MODEL=deepseek-chat
#   MEM0_DEFAULT_EMBEDDER_PROVIDER=gemini / MEM0_DEFAULT_EMBEDDER_MODEL=models/gemini-embedding-001
#   MEM0_DEFAULT_EMBEDDER_DIMS=768
MEM0_DEFAULT_LLM_PROVIDER=openai
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_PROVIDER=openai
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
# Must match the embedder's output size. Changing it after memories exist
# requires a new POSTGRES_COLLECTION_NAME (the vector column width is fixed).
MEM0_DEFAULT_EMBEDDER_DIMS=1536

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30

# Writes whose text looks like a credential (API keys, tokens, private keys) are rejected with a 400,
# because memory text is sent to the LLM provider and stored in plaintext. Keep secrets in a vault.
# Set to true only if you accept that risk.
MEM0_ALLOW_SECRETS=false
